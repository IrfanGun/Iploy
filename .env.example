PANEL_ENV=development
PANEL_ADDR=127.0.0.1:8080
PANEL_PUBLIC_URL=http://localhost:5173
PANEL_DATA_DIR=./data
PANEL_MASTER_KEY=
PANEL_DOCKER_NETWORK=panel_apps
PANEL_TRAEFIK_CONFIG_DIR=./data/traefik/dynamic
PANEL_BUILD_TIMEOUT=20m
PANEL_HEALTH_TIMEOUT=60s
PANEL_RETAIN_IMAGES=5
PANEL_MAX_LOG_BYTES=10485760
# Optional one-time admin seeder input. Set locally, then remove the password after seeding.
PANEL_ADMIN_USERNAME=
PANEL_ADMIN_PASSWORD=
